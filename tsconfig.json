{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      /* Architectural boundaries — see docs/PROJECT-STRUCTURE.md.
         Every import states its own safety:
           @shared/*    safe in the browser and on the server
           @frontend/*  customer UI, never imports backend
           @backend/*   server only, never reaches the browser
           @admin/*     Payload admin presentation */
      "@frontend/*": ["./src/frontend/*"],
      "@backend/*": ["./src/backend/*"],
      "@admin/*": ["./src/admin/*"],
      "@shared/*": ["./src/shared/*"],

      /* Legacy — removed in step 8, once every import has moved. */
      "@/*": ["./src/*"],

      "@payload-config": ["./src/payload.config.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
