# Copy to .env.local and fill in. NEVER commit real values.

# --- Required (backend cannot boot without these) ---
# Neon Postgres connection string (dev branch locally, prod branch on Vercel)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Min 32 chars. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Public ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Observability / infra (optional in dev, REQUIRED in production) ---
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (REQUIRED in production) ---
# Vercel Blob read/write token. Server-side only - never NEXT_PUBLIC_.
# Vercel injects this automatically once a Blob store is connected to the
# project (Vercel dashboard -> Storage -> Blob -> Connect Project).
# Leave EMPTY locally: uploads then go to ./uploads on disk, which is
# development-only and is refused in production. See docs/DEPLOYMENT.md §4.
BLOB_READ_WRITE_TOKEN=

# --- Hero film (OPTIONAL — the site is complete without it) ---
# The hero renders its poster photography and looks finished with both of
# these empty; that is the shipped default, not a placeholder state. Set
# them only once a real encode exists, and NEVER commit the file itself —
# it is uploaded to Vercel Blob or a CDN and referenced by URL.
#
# Landscape encode (used at >=1024px). Phones are given the film only if
# the portrait encode below is also set, because a landscape film letter-
# boxed into a 9:16 hero looks worse than the photograph does.
# Encoding guidance lives in src/lib/hero-media.ts.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_VIDEO_URL_MOBILE=
