# Copy to .env.local and fill in. NEVER commit real values.

# --- Required (backend cannot boot without these) ---
# Neon Postgres connection string (dev branch locally, prod branch on Vercel)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Min 32 chars. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Public ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Observability / infra (optional in dev, REQUIRED in production) ---
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (production needs ONE of the two below) ---
# Server-side only - never NEXT_PUBLIC_.
#
# BLOB_STORE_ID is the credential on Vercel. Connecting a Blob store
# (dashboard -> Storage -> Blob -> Connect Project) sets it, and the store
# authenticates by OIDC: the runtime issues a short-lived token per request,
# so there is no long-lived token to copy anywhere. Nothing to fill in here -
# Vercel provides it to the deployment.
BLOB_STORE_ID=
#
# BLOB_READ_WRITE_TOKEN is the LEGACY fallback, for running outside Vercel
# (a CI job or another host). It is NOT required for the Vercel-connected
# deployment and does not need to be created. The SDK prefers an explicit
# token over OIDC, so set it only when you mean to bypass OIDC.
BLOB_READ_WRITE_TOKEN=
#
# Leave BOTH empty locally: uploads then go to ./uploads on disk, which is
# development-only and is refused in production. OIDC credentials exist only
# inside Vercel, so blob storage cannot be exercised from local development -
# verify it on a preview deployment. See docs/DEPLOYMENT.md §4.

# --- Hero film (OPTIONAL — the site is complete without it) ---
# The hero renders its poster photography and looks finished with both of
# these empty; that is the shipped default, not a placeholder state. Set
# them only once a real encode exists, and NEVER commit the file itself —
# it is uploaded to Vercel Blob or a CDN and referenced by URL.
#
# Landscape encode (used at >=1024px). Phones are given the film only if
# the portrait encode below is also set, because a landscape film letter-
# boxed into a 9:16 hero looks worse than the photograph does.
# Encoding guidance lives in src/lib/hero-media.ts.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_VIDEO_URL_MOBILE=
