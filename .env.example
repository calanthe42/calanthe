# Copy to .env.local and fill in. NEVER commit real values.

# --- Required (backend cannot boot without these) ---
# Neon Postgres connection string (dev branch locally, prod branch on Vercel)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Min 32 chars. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Public ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Observability / infra (optional in dev, REQUIRED in production) ---
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (REQUIRED in production) ---
# Vercel Blob read/write token. Server-side only - never NEXT_PUBLIC_.
# Vercel injects this automatically once a Blob store is connected to the
# project (Vercel dashboard -> Storage -> Blob -> Connect Project).
# Leave EMPTY locally: uploads then go to ./uploads on disk, which is
# development-only and is refused in production. See docs/DEPLOYMENT.md §4.
BLOB_READ_WRITE_TOKEN=
